outputs/**/logs/
outputs/**/*.part
outputs/**/*.tmp

# The paper candidate IS tracked (small, authoritative). Whitelist it under
# the otherwise-ignored outputs/ tree.
outputs/*
!outputs/paper_candidate/
!outputs/paper_candidate/**

# Transient status files (fully covered by final reports and candidate
# manifests).
status/calibration_status.json
status/fast_run_status.json
status/full_run_status.json
status/fast_targeted_status.json
status/full_targeted_status.json
status/fast_validation_status.json
status/full_validation_status.json
status/paper_promotion_status.json
