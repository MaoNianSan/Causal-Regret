# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Environments
.venv/
venv/
env/

# Notebook / editor / OS
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Logs and temporary files
*.log
*.tmp
*.temp
*.part
*.lock
*.bak
*.swp
*~

# Exp1 transient run outputs (kept locally for reproducibility, not tracked).
outputs/fast/
outputs/full/
outputs/dev*/
outputs/tmp*/
outputs/**/cache/
outputs/**/logs/
outputs/**/*.part
outputs/**/*.tmp

# The paper candidate IS tracked (small, authoritative). Whitelist it under
# the otherwise-ignored outputs/ tree.
outputs/*
!outputs/paper_candidate/
!outputs/paper_candidate/**

# Transient status files (fully covered by final reports and candidate
# manifests).
status/calibration_status.json
status/fast_run_status.json
status/full_run_status.json
status/fast_targeted_status.json
status/full_targeted_status.json
status/fast_validation_status.json
status/full_validation_status.json
status/paper_promotion_status.json
status/targeted_paper_promotion_status.json

# --- Cloud-readable selective unignore of the accepted full run (2026-09-10) ---
# Expose lightweight scientific result subtrees for GitHub readers while
# keeping raw/heavy/binary material local. Parent ignore rules prevent
# descent, so each subtree is unignored explicitly.
outputs/full/*
!outputs/full/
!outputs/full/derived/
!outputs/full/derived/**
!outputs/full/targeted/
!outputs/full/targeted/**
!outputs/full/checks/
!outputs/full/checks/**
!outputs/full/metadata/
!outputs/full/metadata/**
!outputs/full/status/
!outputs/full/status/**
!outputs/full/reports/
!outputs/full/reports/**
!outputs/full/tables/
!outputs/full/tables/**
!outputs/full/figures/
!outputs/full/figures/**
!outputs/full/manuscript/
!outputs/full/manuscript/**
!outputs/full/seed_metrics/
!outputs/full/seed_metrics/**

# Heavy, intermediate, and binary outputs stay local.
outputs/full/raw/
outputs/full/processed/
outputs/full/intermediate/
outputs/full/cache/
outputs/full/logs/
outputs/full/**/*.parquet
outputs/full/**/*.pkl
outputs/full/**/*.joblib
