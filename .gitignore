# Python and notebook caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Runtime and temporary state
.runtime/
*.pid
*.tmp
*.temp
*.bak
*.backup
*.log.tmp
tmp/
temp/
cache/

# Environments and secrets
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# OS, editor, and nested VCS metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
**/.git/

# Archives, binary artifacts, and local downloads
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.parquet
*.pkl
*.joblib
downloads/
datasets/
data/raw/
data/external/

# Per-project output runs (large generated artifacts).
# Each project has its own .gitignore for outputs/runs/.
# Keep only lightweight placement notes (.gitkeep) in output trees.
**/inputs/**
!**/inputs/
!**/inputs/README.md
**/input/raw/
**/input/external/

# Large model/cache files
.cache/
models/
model_cache/
huggingface_cache/
*.pt
*.pth
*.ckpt
*.onnx
*.npy
*.npz
*.feather

# Heavy experiment intermediates
**/outputs/**/processed/
**/outputs/**/raw/
**/outputs/**/intermediate/
**/outputs/**/cache/
**/outputs/**/raw_large/

# Exp2-specific: audit diagnostics, derived data, and run logs in output trees
**/outputs/**/audit/
**/outputs/**/derived/
**/outputs/**/logs/
**/run_manifest.json

# Exp3 development artifacts (process trail, not experiment outputs)
exp3_sequential_recommendation_delayed_feedback/audit/
exp3_sequential_recommendation_delayed_feedback/deliverables/
exp3_sequential_recommendation_delayed_feedback/validation/

# Keep GitHub-facing lightweight outputs explicitly visible.
!README.md
!LICENSE
!LICENSE_PENDING.md
!LICENSE_SELECTION_REQUIRED.md
!requirements.txt
!environment.yml
!**/README.md
!**/requirements.txt
!**/docs/**
!**/notebooks/**
!**/runlogs/*.md
!**/runlogs/*.txt
!**/runlogs/*.log
!**/output_manifest.md
!**/outputs/**/summary*.csv
!**/outputs/**/summaries/**
!**/outputs/**/summary/**
!**/outputs/**/tables/**
!**/outputs/**/figures/**
!**/outputs/**/checks/**
!**/outputs/**/metadata/**
!**/outputs/**/reports/**
!**/outputs/**/derived/**
!**/outputs/**/manuscript/**
!**/outputs/**/seed_metrics/**
!**/outputs/**/targeted/**
!**/outputs/**/seed_metrics/*.parquet
