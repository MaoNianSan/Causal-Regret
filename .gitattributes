# Normalize text files across platforms.
* text=auto

# Source and documentation files use LF in the repository.
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.tsv text eol=lf
*.tex text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
# Generated SVG path data is emitted multi-line with trailing spaces by
# matplotlib; disable trailing-whitespace checks for these generated files.
*.svg text eol=lf whitespace=-trailing-space
*.diff text eol=lf
*.lock text eol=lf
*.ini text eol=lf
*.cfg text eol=lf

# Binary artifacts.
*.png binary
*.pdf binary
*.ipynb text eol=lf
*.gz binary
*.parquet binary
*.pkl binary
*.joblib binary
*.pt binary
*.onnx binary
*.zip binary
*.tar binary
*.tgz binary
*.feather binary
*.npy binary
*.npz binary

# Repository placeholder files.
.gitkeep text eol=lf
